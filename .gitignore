# ----------------------------------------------------
# Universal .gitignore for Python + TypeScript + Node.js
# + Common IDE / OS / Build files
# ----------------------------------------------------

# =========================
# OS Generated Files
# =========================
.DS_Store
Thumbs.db
desktop.ini

# =========================
# Logs
# =========================
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# =========================
# Environment Variables
# =========================
.env
.env.*
!.env.example

# =========================
# Python
# =========================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
downloads/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
pip-wheel-metadata/

# Python Virtual Environments
venv/
env/
ENV/
.venv/

# Python Testing / Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.mypy_cache/
.dmypy.json
.pyre/
.ruff_cache/

# Jupyter Notebook
.ipynb_checkpoints/

# =========================
# Node.js / TypeScript
# =========================
node_modules/
npm-cache/
.pnpm-store/
.yarn/
.yarn-cache/

# TypeScript Build Output
dist/
build/
out/
*.tsbuildinfo

# Frameworks
.next/
.nuxt/
.svelte-kit/
.angular/
vite.svg

# =========================
# Package Lock Files (optional)
# Uncomment if you don't want lockfiles
# package-lock.json
# yarn.lock
# pnpm-lock.yaml

# =========================
# IDE / Editors
# =========================
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# =========================
# Docker
# =========================
*.pid
*.seed
*.pid.lock

# =========================
# Terraform
# =========================
.terraform/
*.tfstate
*.tfstate.*
crash.log

# =========================
# Kubernetes
# =========================
*.kubeconfig
kubeconfig.yaml

# =========================
# Secrets / Keys
# =========================
*.pem
*.key
*.crt
*.p12

# =========================
# Misc
# =========================
tmp/
temp/
.cache/
coverage/
reports/

# =========================
# Optional Binary Files
# =========================
*.exe
*.dll
*.obj
*.o
*.class
*.jar